<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:axis_mobile_app.PageModels"
             x:Class="axis_mobile_app.Pages.MainPage"
             x:DataType="pageModels:MainPageModel"
             Title="Land Battle Simulator">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label Text="Axis &amp; Allies Land Battle" FontSize="24" FontAttributes="Bold" />
            <Label Text="Use +/- buttons to configure both armies, then run many battles." FontSize="14" Opacity="0.8" />

            <Border Padding="12" Stroke="LightGray" StrokeThickness="1">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Attacking Army" FontAttributes="Bold" FontSize="18" />
                    <Label Text="Cost: {Binding AttackerCost} CP" />

                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                        <Label Grid.Row="0" Grid.Column="0" Text="Infantry" />
                        <Button Grid.Row="0" Grid.Column="1" Text="-" Command="{Binding DecrementUnitCommand}" CommandParameter="attacker_infantry" />
                        <Label Grid.Row="0" Grid.Column="2" Text="{Binding AttackerInfantry}" HorizontalTextAlignment="Center" WidthRequest="40" />
                        <Button Grid.Row="0" Grid.Column="3" Text="+" Command="{Binding IncrementUnitCommand}" CommandParameter="attacker_infantry" />

                        <Label Grid.Row="1" Grid.Column="0" Text="Artillery" />
                        <Button Grid.Row="1" Grid.Column="1" Text="-" Command="{Binding DecrementUnitCommand}" CommandParameter="attacker_artillery" />
                        <Label Grid.Row="1" Grid.Column="2" Text="{Binding AttackerArtillery}" HorizontalTextAlignment="Center" WidthRequest="40" />
                        <Button Grid.Row="1" Grid.Column="3" Text="+" Command="{Binding IncrementUnitCommand}" CommandParameter="attacker_artillery" />

                        <Label Grid.Row="2" Grid.Column="0" Text="Tank" />
                        <Button Grid.Row="2" Grid.Column="1" Text="-" Command="{Binding DecrementUnitCommand}" CommandParameter="attacker_tank" />
                        <Label Grid.Row="2" Grid.Column="2" Text="{Binding AttackerTank}" HorizontalTextAlignment="Center" WidthRequest="40" />
                        <Button Grid.Row="2" Grid.Column="3" Text="+" Command="{Binding IncrementUnitCommand}" CommandParameter="attacker_tank" />

                        <Label Grid.Row="3" Grid.Column="0" Text="Fighter" />
                        <Button Grid.Row="3" Grid.Column="1" Text="-" Command="{Binding DecrementUnitCommand}" CommandParameter="attacker_fighter" />
                        <Label Grid.Row="3" Grid.Column="2" Text="{Binding AttackerFighter}" HorizontalTextAlignment="Center" WidthRequest="40" />
                        <Button Grid.Row="3" Grid.Column="3" Text="+" Command="{Binding IncrementUnitCommand}" CommandParameter="attacker_fighter" />

                        <Label Grid.Row="4" Grid.Column="0" Text="Bomber" />
                        <Button Grid.Row="4" Grid.Column="1" Text="-" Command="{Binding DecrementUnitCommand}" CommandParameter="attacker_bomber" />
                        <Label Grid.Row="4" Grid.Column="2" Text="{Binding AttackerBomber}" HorizontalTextAlignment="Center" WidthRequest="40" />
                        <Button Grid.Row="4" Grid.Column="3" Text="+" Command="{Binding IncrementUnitCommand}" CommandParameter="attacker_bomber" />

                        <Label Grid.Row="5" Grid.Column="0" Text="Anti-Air" />
                        <Button Grid.Row="5" Grid.Column="1" Text="-" Command="{Binding DecrementUnitCommand}" CommandParameter="attacker_antiair" />
                        <Label Grid.Row="5" Grid.Column="2" Text="{Binding AttackerAntiAir}" HorizontalTextAlignment="Center" WidthRequest="40" />
                        <Button Grid.Row="5" Grid.Column="3" Text="+" Command="{Binding IncrementUnitCommand}" CommandParameter="attacker_antiair" />

                        <Label Grid.Row="6" Grid.Column="0" Text="Cruiser" />
                        <Button Grid.Row="6" Grid.Column="1" Text="-" Command="{Binding DecrementUnitCommand}" CommandParameter="attacker_cruiser" />
                        <Label Grid.Row="6" Grid.Column="2" Text="{Binding AttackerCruiser}" HorizontalTextAlignment="Center" WidthRequest="40" />
                        <Button Grid.Row="6" Grid.Column="3" Text="+" Command="{Binding IncrementUnitCommand}" CommandParameter="attacker_cruiser" />

                        <Label Grid.Row="7" Grid.Column="0" Text="Battleship" />
                        <Button Grid.Row="7" Grid.Column="1" Text="-" Command="{Binding DecrementUnitCommand}" CommandParameter="attacker_battleship" />
                        <Label Grid.Row="7" Grid.Column="2" Text="{Binding AttackerBattleship}" HorizontalTextAlignment="Center" WidthRequest="40" />
                        <Button Grid.Row="7" Grid.Column="3" Text="+" Command="{Binding IncrementUnitCommand}" CommandParameter="attacker_battleship" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Padding="12" Stroke="LightGray" StrokeThickness="1">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Defending Army" FontAttributes="Bold" FontSize="18" />
                    <Label Text="Cost: {Binding DefenderCost} CP" />

                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                        <Label Grid.Row="0" Grid.Column="0" Text="Infantry" />
                        <Button Grid.Row="0" Grid.Column="1" Text="-" Command="{Binding DecrementUnitCommand}" CommandParameter="defender_infantry" />
                        <Label Grid.Row="0" Grid.Column="2" Text="{Binding DefenderInfantry}" HorizontalTextAlignment="Center" WidthRequest="40" />
                        <Button Grid.Row="0" Grid.Column="3" Text="+" Command="{Binding IncrementUnitCommand}" CommandParameter="defender_infantry" />

                        <Label Grid.Row="1" Grid.Column="0" Text="Artillery" />
                        <Button Grid.Row="1" Grid.Column="1" Text="-" Command="{Binding DecrementUnitCommand}" CommandParameter="defender_artillery" />
                        <Label Grid.Row="1" Grid.Column="2" Text="{Binding DefenderArtillery}" HorizontalTextAlignment="Center" WidthRequest="40" />
                        <Button Grid.Row="1" Grid.Column="3" Text="+" Command="{Binding IncrementUnitCommand}" CommandParameter="defender_artillery" />

                        <Label Grid.Row="2" Grid.Column="0" Text="Tank" />
                        <Button Grid.Row="2" Grid.Column="1" Text="-" Command="{Binding DecrementUnitCommand}" CommandParameter="defender_tank" />
                        <Label Grid.Row="2" Grid.Column="2" Text="{Binding DefenderTank}" HorizontalTextAlignment="Center" WidthRequest="40" />
                        <Button Grid.Row="2" Grid.Column="3" Text="+" Command="{Binding IncrementUnitCommand}" CommandParameter="defender_tank" />

                        <Label Grid.Row="3" Grid.Column="0" Text="Fighter" />
                        <Button Grid.Row="3" Grid.Column="1" Text="-" Command="{Binding DecrementUnitCommand}" CommandParameter="defender_fighter" />
                        <Label Grid.Row="3" Grid.Column="2" Text="{Binding DefenderFighter}" HorizontalTextAlignment="Center" WidthRequest="40" />
                        <Button Grid.Row="3" Grid.Column="3" Text="+" Command="{Binding IncrementUnitCommand}" CommandParameter="defender_fighter" />

                        <Label Grid.Row="4" Grid.Column="0" Text="Bomber" />
                        <Button Grid.Row="4" Grid.Column="1" Text="-" Command="{Binding DecrementUnitCommand}" CommandParameter="defender_bomber" />
                        <Label Grid.Row="4" Grid.Column="2" Text="{Binding DefenderBomber}" HorizontalTextAlignment="Center" WidthRequest="40" />
                        <Button Grid.Row="4" Grid.Column="3" Text="+" Command="{Binding IncrementUnitCommand}" CommandParameter="defender_bomber" />

                        <Label Grid.Row="5" Grid.Column="0" Text="Anti-Air" />
                        <Button Grid.Row="5" Grid.Column="1" Text="-" Command="{Binding DecrementUnitCommand}" CommandParameter="defender_antiair" />
                        <Label Grid.Row="5" Grid.Column="2" Text="{Binding DefenderAntiAir}" HorizontalTextAlignment="Center" WidthRequest="40" />
                        <Button Grid.Row="5" Grid.Column="3" Text="+" Command="{Binding IncrementUnitCommand}" CommandParameter="defender_antiair" />

                        <Label Grid.Row="6" Grid.Column="0" Text="Cruiser" />
                        <Button Grid.Row="6" Grid.Column="1" Text="-" Command="{Binding DecrementUnitCommand}" CommandParameter="defender_cruiser" />
                        <Label Grid.Row="6" Grid.Column="2" Text="{Binding DefenderCruiser}" HorizontalTextAlignment="Center" WidthRequest="40" />
                        <Button Grid.Row="6" Grid.Column="3" Text="+" Command="{Binding IncrementUnitCommand}" CommandParameter="defender_cruiser" />

                        <Label Grid.Row="7" Grid.Column="0" Text="Battleship" />
                        <Button Grid.Row="7" Grid.Column="1" Text="-" Command="{Binding DecrementUnitCommand}" CommandParameter="defender_battleship" />
                        <Label Grid.Row="7" Grid.Column="2" Text="{Binding DefenderBattleship}" HorizontalTextAlignment="Center" WidthRequest="40" />
                        <Button Grid.Row="7" Grid.Column="3" Text="+" Command="{Binding IncrementUnitCommand}" CommandParameter="defender_battleship" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Padding="12" Stroke="LightGray" StrokeThickness="1">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Simulation Count" FontAttributes="Bold" FontSize="18" />
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8">
                        <Button Grid.Column="0" Text="-" Command="{Binding DecrementSimulationCountCommand}" />
                        <Label Grid.Column="1" Text="{Binding SimulationCount}" VerticalTextAlignment="Center" WidthRequest="80" HorizontalTextAlignment="Center" />
                        <Button Grid.Column="2" Text="+" Command="{Binding IncrementSimulationCountCommand}" />
                        <Button Grid.Column="3" Text="Run" Command="{Binding RunSimulationCommand}" />
                    </Grid>
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                    <Label Text="{Binding StatusMessage}" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="12" Stroke="LightGray" StrokeThickness="1">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Results" FontAttributes="Bold" FontSize="18" />
                    <Label Text="{Binding ResultsText}" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
