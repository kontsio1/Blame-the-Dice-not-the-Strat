<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             xmlns:pageModels="clr-namespace:axis_mobile_app.PageModels"
             x:Class="axis_mobile_app.Pages.CounterResultsPage"
             x:DataType="pageModels:CounterPageModel"
             Title="Counter Results">

    <ScrollView x:Name="PageScrollView">
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label Text="Find Counter Results"
                   FontSize="24"
                   FontAttributes="Bold" />
            <Label Text="{Binding ResultsSummaryText}"
                   FontSize="14"
                   Opacity="0.8" />

            <FlexLayout Direction="Row"
                        Wrap="Wrap"
                        JustifyContent="SpaceBetween"
                        AlignItems="Start">
                <Border Padding="12"
                        Stroke="LightGray"
                        StrokeThickness="1"
                        Margin="0,0,0,12"
                        MinimumWidthRequest="300"
                        FlexLayout.Basis="48%"
                        FlexLayout.Grow="1">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding TargetArmySummaryText}"
                               FontAttributes="Bold"
                               FontSize="18" />
                        <Label Text="{Binding TargetArmyCostText}"
                               FontAttributes="Bold" />
                        <Label Text="{Binding TargetArmyCompositionText}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="12"
                        Stroke="LightGray"
                        StrokeThickness="1"
                        Margin="0,0,0,12"
                        MinimumWidthRequest="300"
                        FlexLayout.Basis="48%"
                        FlexLayout.Grow="1">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding BestCounterArmySummaryText}"
                               FontAttributes="Bold"
                               FontSize="18" />
                        <Label Text="{Binding BestCounterArmyCostText}"
                               FontAttributes="Bold" />
                        <Label Text="{Binding BestCounterArmyCompositionText}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>
            </FlexLayout>

            <Border Padding="12" Stroke="LightGray" StrokeThickness="1">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Battle Outcomes" FontAttributes="Bold" FontSize="18" />
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Result" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="Count" FontAttributes="Bold" HorizontalTextAlignment="End" />
                        <Label Grid.Column="2" Text="Percentage" FontAttributes="Bold" HorizontalTextAlignment="End" />
                    </Grid>
                    <CollectionView ItemsSource="{Binding BattleOutcomeRows}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="pageModels:OutcomeRow">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Padding="0,2">
                                    <Label Grid.Column="0" Text="{Binding Result}" />
                                    <Label Grid.Column="1" Text="{Binding Count}" HorizontalTextAlignment="End" />
                                    <Label Grid.Column="2" Text="{Binding Percentage}" HorizontalTextAlignment="End" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Border Padding="12" Stroke="LightGray" StrokeThickness="1">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Target vs Best Counter" FontAttributes="Bold" FontSize="18" />
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Unit" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="Target" FontAttributes="Bold" HorizontalTextAlignment="End" />
                        <Label Grid.Column="2" Text="Counter" FontAttributes="Bold" HorizontalTextAlignment="End" />
                    </Grid>
                    <CollectionView ItemsSource="{Binding ArmyCompositionRows}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="pageModels:ComparisonRow">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Padding="0,2">
                                    <Label Grid.Column="0" Text="{Binding Unit}" />
                                    <Label Grid.Column="1" Text="{Binding Attacker}" HorizontalTextAlignment="End" />
                                    <Label Grid.Column="2" Text="{Binding Defender}" HorizontalTextAlignment="End" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Border Padding="12" Stroke="LightGray" StrokeThickness="1">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Average Remaining Units" FontAttributes="Bold" FontSize="18" />
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Unit" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="Attacker" FontAttributes="Bold" HorizontalTextAlignment="End" />
                        <Label Grid.Column="2" Text="Defender" FontAttributes="Bold" HorizontalTextAlignment="End" />
                    </Grid>
                    <CollectionView ItemsSource="{Binding RemainingUnitsRows}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="pageModels:ComparisonRow">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Padding="0,2">
                                    <Label Grid.Column="0" Text="{Binding Unit}" />
                                    <Label Grid.Column="1" Text="{Binding Attacker}" HorizontalTextAlignment="End" />
                                    <Label Grid.Column="2" Text="{Binding Defender}" HorizontalTextAlignment="End" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Border Padding="12" Stroke="LightGray" StrokeThickness="1">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Summary Metrics" FontAttributes="Bold" FontSize="18" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Metric" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="Value" FontAttributes="Bold" HorizontalTextAlignment="End" />
                    </Grid>
                    <CollectionView ItemsSource="{Binding SummaryMetricRows}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="pageModels:MetricRow">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="0,2">
                                    <Label Grid.Column="0" Text="{Binding Metric}" />
                                    <Label Grid.Column="1" Text="{Binding Value}" HorizontalTextAlignment="End" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Border Padding="12" Stroke="LightGray" StrokeThickness="1">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Probability Distribution (Attacker IPC - Defender IPC)" FontAttributes="Bold" FontSize="18" />
                    <lvc:CartesianChart Series="{Binding ProbabilityDistributionSeries}"
                                        XAxes="{Binding ProbabilityDistributionXAxes}"
                                        YAxes="{Binding ProbabilityDistributionYAxes}"
                                        LegendPosition="Top"
                                        HeightRequest="320" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="12" Stroke="LightGray" StrokeThickness="1">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Analyze Actual Outcome" FontAttributes="Bold" FontSize="18" />
                    <Label Text="Enter the actual remaining units from the real battle to see how lucky the result was. For counter searches, the counter army is the attacker in the final matchup."
                           FontSize="14"
                           Opacity="0.8" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding IsLandArmy}">
                        <Border Grid.Column="0" Padding="10" Stroke="LightGray" StrokeThickness="1">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Attacker Remaining Units" FontAttributes="Bold" />
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                                    <Label Grid.Row="0" Text="Infantry" />
                                    <Button Grid.Row="0" Grid.Column="1" Text="-" Command="{Binding DecrementActualOutcomeUnitCommand}" CommandParameter="attacker_infantry" />
                                    <Entry Grid.Row="0" Grid.Column="2" Text="{Binding ActualAttackerRemaining.Infantry}" Keyboard="Numeric" WidthRequest="70" HorizontalTextAlignment="Center" />
                                    <Button Grid.Row="0" Grid.Column="3" Text="+" Command="{Binding IncrementActualOutcomeUnitCommand}" CommandParameter="attacker_infantry" />
                                    <Label Grid.Row="1" Text="Artillery" />
                                    <Button Grid.Row="1" Grid.Column="1" Text="-" Command="{Binding DecrementActualOutcomeUnitCommand}" CommandParameter="attacker_artillery" />
                                    <Entry Grid.Row="1" Grid.Column="2" Text="{Binding ActualAttackerRemaining.Artillery}" Keyboard="Numeric" WidthRequest="70" HorizontalTextAlignment="Center" />
                                    <Button Grid.Row="1" Grid.Column="3" Text="+" Command="{Binding IncrementActualOutcomeUnitCommand}" CommandParameter="attacker_artillery" />
                                    <Label Grid.Row="2" Text="Tank" />
                                    <Button Grid.Row="2" Grid.Column="1" Text="-" Command="{Binding DecrementActualOutcomeUnitCommand}" CommandParameter="attacker_tank" />
                                    <Entry Grid.Row="2" Grid.Column="2" Text="{Binding ActualAttackerRemaining.Tank}" Keyboard="Numeric" WidthRequest="70" HorizontalTextAlignment="Center" />
                                    <Button Grid.Row="2" Grid.Column="3" Text="+" Command="{Binding IncrementActualOutcomeUnitCommand}" CommandParameter="attacker_tank" />
                                    <Label Grid.Row="3" Text="Fighter" />
                                    <Button Grid.Row="3" Grid.Column="1" Text="-" Command="{Binding DecrementActualOutcomeUnitCommand}" CommandParameter="attacker_fighter" />
                                    <Entry Grid.Row="3" Grid.Column="2" Text="{Binding ActualAttackerRemaining.Fighter}" Keyboard="Numeric" WidthRequest="70" HorizontalTextAlignment="Center" />
                                    <Button Grid.Row="3" Grid.Column="3" Text="+" Command="{Binding IncrementActualOutcomeUnitCommand}" CommandParameter="attacker_fighter" />
                                    <Label Grid.Row="4" Text="Bomber" />
                                    <Button Grid.Row="4" Grid.Column="1" Text="-" Command="{Binding DecrementActualOutcomeUnitCommand}" CommandParameter="attacker_bomber" />
                                    <Entry Grid.Row="4" Grid.Column="2" Text="{Binding ActualAttackerRemaining.Bomber}" Keyboard="Numeric" WidthRequest="70" HorizontalTextAlignment="Center" />
                                    <Button Grid.Row="4" Grid.Column="3" Text="+" Command="{Binding IncrementActualOutcomeUnitCommand}" CommandParameter="attacker_bomber" />
                                    <Label Grid.Row="5" Text="Anti-Air" />
                                    <Button Grid.Row="5" Grid.Column="1" Text="-" Command="{Binding DecrementActualOutcomeUnitCommand}" CommandParameter="attacker_antiair" />
                                    <Entry Grid.Row="5" Grid.Column="2" Text="{Binding ActualAttackerRemaining.AntiAir}" Keyboard="Numeric" WidthRequest="70" HorizontalTextAlignment="Center" />
                                    <Button Grid.Row="5" Grid.Column="3" Text="+" Command="{Binding IncrementActualOutcomeUnitCommand}" CommandParameter="attacker_antiair" />
                                    <Label Grid.Row="6" Text="Cruiser" />
                                    <Button Grid.Row="6" Grid.Column="1" Text="-" Command="{Binding DecrementActualOutcomeUnitCommand}" CommandParameter="attacker_cruiser" />
                                    <Entry Grid.Row="6" Grid.Column="2" Text="{Binding ActualAttackerRemaining.Cruiser}" Keyboard="Numeric" WidthRequest="70" HorizontalTextAlignment="Center" />
                                    <Button Grid.Row="6" Grid.Column="3" Text="+" Command="{Binding IncrementActualOutcomeUnitCommand}" CommandParameter="attacker_cruiser" />
                                    <Label Grid.Row="7" Text="Battleship" />
                                    <Button Grid.Row="7" Grid.Column="1" Text="-" Command="{Binding DecrementActualOutcomeUnitCommand}" CommandParameter="attacker_battleship" />
                                    <Entry Grid.Row="7" Grid.Column="2" Text="{Binding ActualAttackerRemaining.Battleship}" Keyboard="Numeric" WidthRequest="70" HorizontalTextAlignment="Center" />
                                    <Button Grid.Row="7" Grid.Column="3" Text="+" Command="{Binding IncrementActualOutcomeUnitCommand}" CommandParameter="attacker_battleship" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" Padding="10" Stroke="LightGray" StrokeThickness="1">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Defender Remaining Units" FontAttributes="Bold" />
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                                    <Label Grid.Row="0" Text="Infantry" />
                                    <Button Grid.Row="0" Grid.Column="1" Text="-" Command="{Binding DecrementActualOutcomeUnitCommand}" CommandParameter="defender_infantry" />
                                    <Entry Grid.Row="0" Grid.Column="2" Text="{Binding ActualDefenderRemaining.Infantry}" Keyboard="Numeric" WidthRequest="70" HorizontalTextAlignment="Center" />
                                    <Button Grid.Row="0" Grid.Column="3" Text="+" Command="{Binding IncrementActualOutcomeUnitCommand}" CommandParameter="defender_infantry" />
                                    <Label Grid.Row="1" Text="Artillery" />
                                    <Button Grid.Row="1" Grid.Column="1" Text="-" Command="{Binding DecrementActualOutcomeUnitCommand}" CommandParameter="defender_artillery" />
                                    <Entry Grid.Row="1" Grid.Column="2" Text="{Binding ActualDefenderRemaining.Artillery}" Keyboard="Numeric" WidthRequest="70" HorizontalTextAlignment="Center" />
                                    <Button Grid.Row="1" Grid.Column="3" Text="+" Command="{Binding IncrementActualOutcomeUnitCommand}" CommandParameter="defender_artillery" />
                                    <Label Grid.Row="2" Text="Tank" />
                                    <Button Grid.Row="2" Grid.Column="1" Text="-" Command="{Binding DecrementActualOutcomeUnitCommand}" CommandParameter="defender_tank" />
                                    <Entry Grid.Row="2" Grid.Column="2" Text="{Binding ActualDefenderRemaining.Tank}" Keyboard="Numeric" WidthRequest="70" HorizontalTextAlignment="Center" />
                                    <Button Grid.Row="2" Grid.Column="3" Text="+" Command="{Binding IncrementActualOutcomeUnitCommand}" CommandParameter="defender_tank" />
                                    <Label Grid.Row="3" Text="Fighter" />
                                    <Button Grid.Row="3" Grid.Column="1" Text="-" Command="{Binding DecrementActualOutcomeUnitCommand}" CommandParameter="defender_fighter" />
                                    <Entry Grid.Row="3" Grid.Column="2" Text="{Binding ActualDefenderRemaining.Fighter}" Keyboard="Numeric" WidthRequest="70" HorizontalTextAlignment="Center" />
                                    <Button Grid.Row="3" Grid.Column="3" Text="+" Command="{Binding IncrementActualOutcomeUnitCommand}" CommandParameter="defender_fighter" />
                                    <Label Grid.Row="4" Text="Bomber" />
                                    <Button Grid.Row="4" Grid.Column="1" Text="-" Command="{Binding DecrementActualOutcomeUnitCommand}" CommandParameter="defender_bomber" />
                                    <Entry Grid.Row="4" Grid.Column="2" Text="{Binding ActualDefenderRemaining.Bomber}" Keyboard="Numeric" WidthRequest="70" HorizontalTextAlignment="Center" />
                                    <Button Grid.Row="4" Grid.Column="3" Text="+" Command="{Binding IncrementActualOutcomeUnitCommand}" CommandParameter="defender_bomber" />
                                    <Label Grid.Row="5" Text="Anti-Air" />
                                    <Button Grid.Row="5" Grid.Column="1" Text="-" Command="{Binding DecrementActualOutcomeUnitCommand}" CommandParameter="defender_antiair" />
                                    <Entry Grid.Row="5" Grid.Column="2" Text="{Binding ActualDefenderRemaining.AntiAir}" Keyboard="Numeric" WidthRequest="70" HorizontalTextAlignment="Center" />
                                    <Button Grid.Row="5" Grid.Column="3" Text="+" Command="{Binding IncrementActualOutcomeUnitCommand}" CommandParameter="defender_antiair" />
                                    <Label Grid.Row="6" Text="Cruiser" />
                                    <Button Grid.Row="6" Grid.Column="1" Text="-" Command="{Binding DecrementActualOutcomeUnitCommand}" CommandParameter="defender_cruiser" />
                                    <Entry Grid.Row="6" Grid.Column="2" Text="{Binding ActualDefenderRemaining.Cruiser}" Keyboard="Numeric" WidthRequest="70" HorizontalTextAlignment="Center" />
                                    <Button Grid.Row="6" Grid.Column="3" Text="+" Command="{Binding IncrementActualOutcomeUnitCommand}" CommandParameter="defender_cruiser" />
                                    <Label Grid.Row="7" Text="Battleship" />
                                    <Button Grid.Row="7" Grid.Column="1" Text="-" Command="{Binding DecrementActualOutcomeUnitCommand}" CommandParameter="defender_battleship" />
                                    <Entry Grid.Row="7" Grid.Column="2" Text="{Binding ActualDefenderRemaining.Battleship}" Keyboard="Numeric" WidthRequest="70" HorizontalTextAlignment="Center" />
                                    <Button Grid.Row="7" Grid.Column="3" Text="+" Command="{Binding IncrementActualOutcomeUnitCommand}" CommandParameter="defender_battleship" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding IsNavalArmy}">
                        <Border Grid.Column="0" Padding="10" Stroke="LightGray" StrokeThickness="1">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Attacker Remaining Units" FontAttributes="Bold" />
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                                    <Label Grid.Row="0" Text="Transport" />
                                    <Button Grid.Row="0" Grid.Column="1" Text="-" Command="{Binding DecrementActualOutcomeUnitCommand}" CommandParameter="attacker_transport" />
                                    <Entry Grid.Row="0" Grid.Column="2" Text="{Binding ActualAttackerRemaining.Transport}" Keyboard="Numeric" WidthRequest="70" HorizontalTextAlignment="Center" />
                                    <Button Grid.Row="0" Grid.Column="3" Text="+" Command="{Binding IncrementActualOutcomeUnitCommand}" CommandParameter="attacker_transport" />
                                    <Label Grid.Row="1" Text="Submarine" />
                                    <Button Grid.Row="1" Grid.Column="1" Text="-" Command="{Binding DecrementActualOutcomeUnitCommand}" CommandParameter="attacker_submarine" />
                                    <Entry Grid.Row="1" Grid.Column="2" Text="{Binding ActualAttackerRemaining.Submarine}" Keyboard="Numeric" WidthRequest="70" HorizontalTextAlignment="Center" />
                                    <Button Grid.Row="1" Grid.Column="3" Text="+" Command="{Binding IncrementActualOutcomeUnitCommand}" CommandParameter="attacker_submarine" />
                                    <Label Grid.Row="2" Text="Destroyer" />
                                    <Button Grid.Row="2" Grid.Column="1" Text="-" Command="{Binding DecrementActualOutcomeUnitCommand}" CommandParameter="attacker_destroyer" />
                                    <Entry Grid.Row="2" Grid.Column="2" Text="{Binding ActualAttackerRemaining.Destroyer}" Keyboard="Numeric" WidthRequest="70" HorizontalTextAlignment="Center" />
                                    <Button Grid.Row="2" Grid.Column="3" Text="+" Command="{Binding IncrementActualOutcomeUnitCommand}" CommandParameter="attacker_destroyer" />
                                    <Label Grid.Row="3" Text="Cruiser" />
                                    <Button Grid.Row="3" Grid.Column="1" Text="-" Command="{Binding DecrementActualOutcomeUnitCommand}" CommandParameter="attacker_cruiser" />
                                    <Entry Grid.Row="3" Grid.Column="2" Text="{Binding ActualAttackerRemaining.Cruiser}" Keyboard="Numeric" WidthRequest="70" HorizontalTextAlignment="Center" />
                                    <Button Grid.Row="3" Grid.Column="3" Text="+" Command="{Binding IncrementActualOutcomeUnitCommand}" CommandParameter="attacker_cruiser" />
                                    <Label Grid.Row="4" Text="Battleship" />
                                    <Button Grid.Row="4" Grid.Column="1" Text="-" Command="{Binding DecrementActualOutcomeUnitCommand}" CommandParameter="attacker_battleship" />
                                    <Entry Grid.Row="4" Grid.Column="2" Text="{Binding ActualAttackerRemaining.Battleship}" Keyboard="Numeric" WidthRequest="70" HorizontalTextAlignment="Center" />
                                    <Button Grid.Row="4" Grid.Column="3" Text="+" Command="{Binding IncrementActualOutcomeUnitCommand}" CommandParameter="attacker_battleship" />
                                    <Label Grid.Row="5" Text="Carrier" />
                                    <Button Grid.Row="5" Grid.Column="1" Text="-" Command="{Binding DecrementActualOutcomeUnitCommand}" CommandParameter="attacker_carrier" />
                                    <Entry Grid.Row="5" Grid.Column="2" Text="{Binding ActualAttackerRemaining.Carrier}" Keyboard="Numeric" WidthRequest="70" HorizontalTextAlignment="Center" />
                                    <Button Grid.Row="5" Grid.Column="3" Text="+" Command="{Binding IncrementActualOutcomeUnitCommand}" CommandParameter="attacker_carrier" />
                                    <Label Grid.Row="6" Text="Fighter" />
                                    <Button Grid.Row="6" Grid.Column="1" Text="-" Command="{Binding DecrementActualOutcomeUnitCommand}" CommandParameter="attacker_fighter" />
                                    <Entry Grid.Row="6" Grid.Column="2" Text="{Binding ActualAttackerRemaining.Fighter}" Keyboard="Numeric" WidthRequest="70" HorizontalTextAlignment="Center" />
                                    <Button Grid.Row="6" Grid.Column="3" Text="+" Command="{Binding IncrementActualOutcomeUnitCommand}" CommandParameter="attacker_fighter" />
                                    <Label Grid.Row="7" Text="Bomber" />
                                    <Button Grid.Row="7" Grid.Column="1" Text="-" Command="{Binding DecrementActualOutcomeUnitCommand}" CommandParameter="attacker_bomber" />
                                    <Entry Grid.Row="7" Grid.Column="2" Text="{Binding ActualAttackerRemaining.Bomber}" Keyboard="Numeric" WidthRequest="70" HorizontalTextAlignment="Center" />
                                    <Button Grid.Row="7" Grid.Column="3" Text="+" Command="{Binding IncrementActualOutcomeUnitCommand}" CommandParameter="attacker_bomber" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" Padding="10" Stroke="LightGray" StrokeThickness="1">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Defender Remaining Units" FontAttributes="Bold" />
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                                    <Label Grid.Row="0" Text="Transport" />
                                    <Button Grid.Row="0" Grid.Column="1" Text="-" Command="{Binding DecrementActualOutcomeUnitCommand}" CommandParameter="defender_transport" />
                                    <Entry Grid.Row="0" Grid.Column="2" Text="{Binding ActualDefenderRemaining.Transport}" Keyboard="Numeric" WidthRequest="70" HorizontalTextAlignment="Center" />
                                    <Button Grid.Row="0" Grid.Column="3" Text="+" Command="{Binding IncrementActualOutcomeUnitCommand}" CommandParameter="defender_transport" />
                                    <Label Grid.Row="1" Text="Submarine" />
                                    <Button Grid.Row="1" Grid.Column="1" Text="-" Command="{Binding DecrementActualOutcomeUnitCommand}" CommandParameter="defender_submarine" />
                                    <Entry Grid.Row="1" Grid.Column="2" Text="{Binding ActualDefenderRemaining.Submarine}" Keyboard="Numeric" WidthRequest="70" HorizontalTextAlignment="Center" />
                                    <Button Grid.Row="1" Grid.Column="3" Text="+" Command="{Binding IncrementActualOutcomeUnitCommand}" CommandParameter="defender_submarine" />
                                    <Label Grid.Row="2" Text="Destroyer" />
                                    <Button Grid.Row="2" Grid.Column="1" Text="-" Command="{Binding DecrementActualOutcomeUnitCommand}" CommandParameter="defender_destroyer" />
                                    <Entry Grid.Row="2" Grid.Column="2" Text="{Binding ActualDefenderRemaining.Destroyer}" Keyboard="Numeric" WidthRequest="70" HorizontalTextAlignment="Center" />
                                    <Button Grid.Row="2" Grid.Column="3" Text="+" Command="{Binding IncrementActualOutcomeUnitCommand}" CommandParameter="defender_destroyer" />
                                    <Label Grid.Row="3" Text="Cruiser" />
                                    <Button Grid.Row="3" Grid.Column="1" Text="-" Command="{Binding DecrementActualOutcomeUnitCommand}" CommandParameter="defender_cruiser" />
                                    <Entry Grid.Row="3" Grid.Column="2" Text="{Binding ActualDefenderRemaining.Cruiser}" Keyboard="Numeric" WidthRequest="70" HorizontalTextAlignment="Center" />
                                    <Button Grid.Row="3" Grid.Column="3" Text="+" Command="{Binding IncrementActualOutcomeUnitCommand}" CommandParameter="defender_cruiser" />
                                    <Label Grid.Row="4" Text="Battleship" />
                                    <Button Grid.Row="4" Grid.Column="1" Text="-" Command="{Binding DecrementActualOutcomeUnitCommand}" CommandParameter="defender_battleship" />
                                    <Entry Grid.Row="4" Grid.Column="2" Text="{Binding ActualDefenderRemaining.Battleship}" Keyboard="Numeric" WidthRequest="70" HorizontalTextAlignment="Center" />
                                    <Button Grid.Row="4" Grid.Column="3" Text="+" Command="{Binding IncrementActualOutcomeUnitCommand}" CommandParameter="defender_battleship" />
                                    <Label Grid.Row="5" Text="Carrier" />
                                    <Button Grid.Row="5" Grid.Column="1" Text="-" Command="{Binding DecrementActualOutcomeUnitCommand}" CommandParameter="defender_carrier" />
                                    <Entry Grid.Row="5" Grid.Column="2" Text="{Binding ActualDefenderRemaining.Carrier}" Keyboard="Numeric" WidthRequest="70" HorizontalTextAlignment="Center" />
                                    <Button Grid.Row="5" Grid.Column="3" Text="+" Command="{Binding IncrementActualOutcomeUnitCommand}" CommandParameter="defender_carrier" />
                                    <Label Grid.Row="6" Text="Fighter" />
                                    <Button Grid.Row="6" Grid.Column="1" Text="-" Command="{Binding DecrementActualOutcomeUnitCommand}" CommandParameter="defender_fighter" />
                                    <Entry Grid.Row="6" Grid.Column="2" Text="{Binding ActualDefenderRemaining.Fighter}" Keyboard="Numeric" WidthRequest="70" HorizontalTextAlignment="Center" />
                                    <Button Grid.Row="6" Grid.Column="3" Text="+" Command="{Binding IncrementActualOutcomeUnitCommand}" CommandParameter="defender_fighter" />
                                    <Label Grid.Row="7" Text="Bomber" />
                                    <Button Grid.Row="7" Grid.Column="1" Text="-" Command="{Binding DecrementActualOutcomeUnitCommand}" CommandParameter="defender_bomber" />
                                    <Entry Grid.Row="7" Grid.Column="2" Text="{Binding ActualDefenderRemaining.Bomber}" Keyboard="Numeric" WidthRequest="70" HorizontalTextAlignment="Center" />
                                    <Button Grid.Row="7" Grid.Column="3" Text="+" Command="{Binding IncrementActualOutcomeUnitCommand}" CommandParameter="defender_bomber" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Analyze Actual Result" Command="{Binding AnalyzeActualOutcomeCommand}" />
                        <Button Text="Clear" Command="{Binding ClearActualOutcomeCommand}" />
                    </HorizontalStackLayout>

                    <Label Text="{Binding ActualOutcomeStatusMessage}" />

                    <CollectionView ItemsSource="{Binding LuckyMetricRows}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="pageModels:LuckyMetricRow">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Padding="0,2">
                                    <Label Grid.Column="0" Text="{Binding Metric}" />
                                    <Label Grid.Column="1" Text="ⓘ" FontAttributes="Bold" ToolTipProperties.Text="{Binding Tooltip}" />
                                    <Label Grid.Column="2" Text="{Binding Value}" HorizontalTextAlignment="End" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

