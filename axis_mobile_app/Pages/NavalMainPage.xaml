<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:axis_mobile_app.PageModels"
             x:Class="axis_mobile_app.Pages.NavalMainPage"
             x:DataType="pageModels:NavalPageModel"
             Title="Naval Battle Simulator">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label Text="Axis &amp; Allies Naval Battle" FontSize="24" FontAttributes="Bold" />
            <Label Text="Use +/- buttons to configure both armadas, then run many battles." FontSize="14" Opacity="0.8" />

            <FlexLayout Direction="Row"
                        Wrap="Wrap"
                        JustifyContent="SpaceBetween"
                        AlignItems="Start">
                <Border Padding="12"
                        Stroke="LightGray"
                        StrokeThickness="1"
                        Margin="0,0,0,12"
                        MinimumWidthRequest="300"
                        FlexLayout.Basis="48%"
                        FlexLayout.Grow="1">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="Attacking Armada" FontAttributes="Bold" FontSize="18" />
                            <Label Grid.Column="1" Text="{Binding AttackerCost, StringFormat='Cost: {0} CP'}" VerticalTextAlignment="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                            <Label Grid.Row="0" Grid.Column="0" Text="Transport" />
                            <Button Grid.Row="0" Grid.Column="1" Text="-" Command="{Binding DecrementUnitCommand}" CommandParameter="attacker_transport" />
                            <Label Grid.Row="0" Grid.Column="2" Text="{Binding AttackerTransport}" HorizontalTextAlignment="Center" WidthRequest="40" />
                            <Button Grid.Row="0" Grid.Column="3" Text="+" Command="{Binding IncrementUnitCommand}" CommandParameter="attacker_transport" />

                            <Label Grid.Row="1" Grid.Column="0" Text="Submarine" />
                            <Button Grid.Row="1" Grid.Column="1" Text="-" Command="{Binding DecrementUnitCommand}" CommandParameter="attacker_submarine" />
                            <Label Grid.Row="1" Grid.Column="2" Text="{Binding AttackerSubmarine}" HorizontalTextAlignment="Center" WidthRequest="40" />
                            <Button Grid.Row="1" Grid.Column="3" Text="+" Command="{Binding IncrementUnitCommand}" CommandParameter="attacker_submarine" />

                            <Label Grid.Row="2" Grid.Column="0" Text="Destroyer" />
                            <Button Grid.Row="2" Grid.Column="1" Text="-" Command="{Binding DecrementUnitCommand}" CommandParameter="attacker_destroyer" />
                            <Label Grid.Row="2" Grid.Column="2" Text="{Binding AttackerDestroyer}" HorizontalTextAlignment="Center" WidthRequest="40" />
                            <Button Grid.Row="2" Grid.Column="3" Text="+" Command="{Binding IncrementUnitCommand}" CommandParameter="attacker_destroyer" />

                            <Label Grid.Row="3" Grid.Column="0" Text="Cruiser" />
                            <Button Grid.Row="3" Grid.Column="1" Text="-" Command="{Binding DecrementUnitCommand}" CommandParameter="attacker_cruiser" />
                            <Label Grid.Row="3" Grid.Column="2" Text="{Binding AttackerCruiser}" HorizontalTextAlignment="Center" WidthRequest="40" />
                            <Button Grid.Row="3" Grid.Column="3" Text="+" Command="{Binding IncrementUnitCommand}" CommandParameter="attacker_cruiser" />

                            <Label Grid.Row="4" Grid.Column="0" Text="Battleship" />
                            <Button Grid.Row="4" Grid.Column="1" Text="-" Command="{Binding DecrementUnitCommand}" CommandParameter="attacker_battleship" />
                            <Label Grid.Row="4" Grid.Column="2" Text="{Binding AttackerBattleship}" HorizontalTextAlignment="Center" WidthRequest="40" />
                            <Button Grid.Row="4" Grid.Column="3" Text="+" Command="{Binding IncrementUnitCommand}" CommandParameter="attacker_battleship" />

                            <Label Grid.Row="5" Grid.Column="0" Text="Carrier" />
                            <Button Grid.Row="5" Grid.Column="1" Text="-" Command="{Binding DecrementUnitCommand}" CommandParameter="attacker_carrier" />
                            <Label Grid.Row="5" Grid.Column="2" Text="{Binding AttackerCarrier}" HorizontalTextAlignment="Center" WidthRequest="40" />
                            <Button Grid.Row="5" Grid.Column="3" Text="+" Command="{Binding IncrementUnitCommand}" CommandParameter="attacker_carrier" />

                            <Label Grid.Row="6" Grid.Column="0" Text="Fighter" />
                            <Button Grid.Row="6" Grid.Column="1" Text="-" Command="{Binding DecrementUnitCommand}" CommandParameter="attacker_fighter" />
                            <Label Grid.Row="6" Grid.Column="2" Text="{Binding AttackerFighter}" HorizontalTextAlignment="Center" WidthRequest="40" />
                            <Button Grid.Row="6" Grid.Column="3" Text="+" Command="{Binding IncrementUnitCommand}" CommandParameter="attacker_fighter" />

                            <Label Grid.Row="7" Grid.Column="0" Text="Bomber" />
                            <Button Grid.Row="7" Grid.Column="1" Text="-" Command="{Binding DecrementUnitCommand}" CommandParameter="attacker_bomber" />
                            <Label Grid.Row="7" Grid.Column="2" Text="{Binding AttackerBomber}" HorizontalTextAlignment="Center" WidthRequest="40" />
                            <Button Grid.Row="7" Grid.Column="3" Text="+" Command="{Binding IncrementUnitCommand}" CommandParameter="attacker_bomber" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Padding="12"
                        Stroke="LightGray"
                        StrokeThickness="1"
                        Margin="0,0,0,12"
                        MinimumWidthRequest="300"
                        FlexLayout.Basis="48%"
                        FlexLayout.Grow="1">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="Defending Armada" FontAttributes="Bold" FontSize="18" />
                            <Label Grid.Column="1" Text="{Binding DefenderCost, StringFormat='Cost: {0} CP'}" VerticalTextAlignment="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                            <Label Grid.Row="0" Grid.Column="0" Text="Transport" />
                            <Button Grid.Row="0" Grid.Column="1" Text="-" Command="{Binding DecrementUnitCommand}" CommandParameter="defender_transport" />
                            <Label Grid.Row="0" Grid.Column="2" Text="{Binding DefenderTransport}" HorizontalTextAlignment="Center" WidthRequest="40" />
                            <Button Grid.Row="0" Grid.Column="3" Text="+" Command="{Binding IncrementUnitCommand}" CommandParameter="defender_transport" />

                            <Label Grid.Row="1" Grid.Column="0" Text="Submarine" />
                            <Button Grid.Row="1" Grid.Column="1" Text="-" Command="{Binding DecrementUnitCommand}" CommandParameter="defender_submarine" />
                            <Label Grid.Row="1" Grid.Column="2" Text="{Binding DefenderSubmarine}" HorizontalTextAlignment="Center" WidthRequest="40" />
                            <Button Grid.Row="1" Grid.Column="3" Text="+" Command="{Binding IncrementUnitCommand}" CommandParameter="defender_submarine" />

                            <Label Grid.Row="2" Grid.Column="0" Text="Destroyer" />
                            <Button Grid.Row="2" Grid.Column="1" Text="-" Command="{Binding DecrementUnitCommand}" CommandParameter="defender_destroyer" />
                            <Label Grid.Row="2" Grid.Column="2" Text="{Binding DefenderDestroyer}" HorizontalTextAlignment="Center" WidthRequest="40" />
                            <Button Grid.Row="2" Grid.Column="3" Text="+" Command="{Binding IncrementUnitCommand}" CommandParameter="defender_destroyer" />

                            <Label Grid.Row="3" Grid.Column="0" Text="Cruiser" />
                            <Button Grid.Row="3" Grid.Column="1" Text="-" Command="{Binding DecrementUnitCommand}" CommandParameter="defender_cruiser" />
                            <Label Grid.Row="3" Grid.Column="2" Text="{Binding DefenderCruiser}" HorizontalTextAlignment="Center" WidthRequest="40" />
                            <Button Grid.Row="3" Grid.Column="3" Text="+" Command="{Binding IncrementUnitCommand}" CommandParameter="defender_cruiser" />

                            <Label Grid.Row="4" Grid.Column="0" Text="Battleship" />
                            <Button Grid.Row="4" Grid.Column="1" Text="-" Command="{Binding DecrementUnitCommand}" CommandParameter="defender_battleship" />
                            <Label Grid.Row="4" Grid.Column="2" Text="{Binding DefenderBattleship}" HorizontalTextAlignment="Center" WidthRequest="40" />
                            <Button Grid.Row="4" Grid.Column="3" Text="+" Command="{Binding IncrementUnitCommand}" CommandParameter="defender_battleship" />

                            <Label Grid.Row="5" Grid.Column="0" Text="Carrier" />
                            <Button Grid.Row="5" Grid.Column="1" Text="-" Command="{Binding DecrementUnitCommand}" CommandParameter="defender_carrier" />
                            <Label Grid.Row="5" Grid.Column="2" Text="{Binding DefenderCarrier}" HorizontalTextAlignment="Center" WidthRequest="40" />
                            <Button Grid.Row="5" Grid.Column="3" Text="+" Command="{Binding IncrementUnitCommand}" CommandParameter="defender_carrier" />

                            <Label Grid.Row="6" Grid.Column="0" Text="Fighter" />
                            <Button Grid.Row="6" Grid.Column="1" Text="-" Command="{Binding DecrementUnitCommand}" CommandParameter="defender_fighter" />
                            <Label Grid.Row="6" Grid.Column="2" Text="{Binding DefenderFighter}" HorizontalTextAlignment="Center" WidthRequest="40" />
                            <Button Grid.Row="6" Grid.Column="3" Text="+" Command="{Binding IncrementUnitCommand}" CommandParameter="defender_fighter" />

                            <Label Grid.Row="7" Grid.Column="0" Text="Bomber" />
                            <Button Grid.Row="7" Grid.Column="1" Text="-" Command="{Binding DecrementUnitCommand}" CommandParameter="defender_bomber" />
                            <Label Grid.Row="7" Grid.Column="2" Text="{Binding DefenderBomber}" HorizontalTextAlignment="Center" WidthRequest="40" />
                            <Button Grid.Row="7" Grid.Column="3" Text="+" Command="{Binding IncrementUnitCommand}" CommandParameter="defender_bomber" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </FlexLayout>

            <Border Padding="12" Stroke="LightGray" StrokeThickness="1">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Simulation Count" FontAttributes="Bold" FontSize="18" />
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                        <Button Grid.Column="0" Text="-" Command="{Binding DecrementSimulationCountCommand}" />
                        <Entry Grid.Column="1"
                               Text="{Binding SimulationCount, Mode=TwoWay}"
                               Keyboard="Numeric"
                               HorizontalTextAlignment="Center" />
                        <Button Grid.Column="2" Text="+" Command="{Binding IncrementSimulationCountCommand}" />
                        <Button Grid.Column="3" Text="Run" Command="{Binding RunSimulationCommand}" />
                        <Button Grid.Column="4" Text="Cancel" Command="{Binding CancelSimulationCommand}" IsVisible="{Binding IsBusy}" />
                    </Grid>
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                    <Label Text="{Binding StatusMessage}" />
                    <Button Text="View Results" Command="{Binding ViewResultsCommand}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Reset Units"
                    Command="{Binding ResetCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

